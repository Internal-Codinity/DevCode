# Development configuration. Copy to .env.local and replace every placeholder.
# Production configuration is documented in docs/production-deployment.md.
DATABASE_URL=postgresql://codium:replace-this-password@localhost:5432/codium
DATABASE_POOL_MAX=10
DATABASE_SSL=false
APP_URL=http://localhost:3000

# Required only in production: transactional email delivery for verification
# and password-reset links. Development logs links to the terminal instead.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=Codura <no-reply@example.com>
# SMTP_USER=
# SMTP_PASSWORD=

# The web process only queues submissions. Set RUNNER_WORKER=true exclusively
# on a separately deployed, trusted judge worker that has Docker access.
RUNNER_ENABLED=true
RUNNER_WORKER=false

# Set only when Docker is not on its default socket. For example:
# RUNNER_DOCKER_HOST=unix:///var/run/docker.sock
